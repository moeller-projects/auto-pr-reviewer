# Only copy what the container needs into the image.
# Everything else is host-only tooling -- and the context is shipped to the
# daemon before any build, so secrets must never be part of it.

# IDE / project metadata
.idea/
.git/
.gitignore

# Secrets and credentials (defense in depth: never leave the host)
.env
.env.*
**/*.pem
**/*.key
**/*.pfx

# Host-only scripts (PowerShell doesn't run in the Linux container)
*.ps1
*.psm1

# Documentation / change records (not needed at runtime)
README.md
docs/
openspec/

# Docker / CI / build metadata
Dockerfile
.dockerignore
azure-pipelines-pr-review.yml

# Python / uv runtime artifacts
.venv/
__pycache__/
*.pyc
.mypy_cache/
.ruff_cache/

# Node (host-only; Pi is installed inside the image)
node_modules/

# Test / coverage / build artifacts
tests/
.pytest_cache/
.coverage
coverage.xml
htmlcov/

# Local workspace / tooling caches
.codegraph/
.omp/
logs/

# Git attributes (host-only, not used at runtime)
.gitattributes